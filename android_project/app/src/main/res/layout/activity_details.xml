<?xml version="1.0" encoding="utf-8"?>
<com.piner.pinertv.ui.widget.FocusStableNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emby_bg_deep"
    android:clipChildren="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/imgBackdrop"
            android:layout_width="0dp"
            android:layout_height="420dp"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_detail_scrim"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="@id/imgBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgPoster"
            android:layout_width="180dp"
            android:layout_height="270dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_card_poster"
            android:contentDescription="@null"
            android:elevation="10dp"
            android:focusable="false"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/emby_text"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/txtMeta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgPoster"
            app:layout_constraintTop_toTopOf="@id/imgPoster"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Título" />

        <TextView
            android:id="@+id/txtMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:textColor="@color/emby_text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/txtOverview"
            app:layout_constraintEnd_toEndOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="@id/txtTitle"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            tools:text="★ 7,5 · 2023 · 2h 10m · (Termina 11:30)" />

        <TextView
            android:id="@+id/txtOverview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:focusable="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/imgPoster"
            app:layout_constraintEnd_toEndOf="@id/txtTitle"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/txtTitle"
            app:layout_constraintTop_toBottomOf="@id/txtMeta"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintWidth_percent="0.52" />

        <TextView
            android:id="@+id/lblOpciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="28dp"
            android:focusable="false"
            android:text="@string/options"
            android:textColor="@color/emby_text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgPoster" />

        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:gravity="start"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblOpciones" />

        <LinearLayout
            android:id="@+id/blockSeasons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowActions"
            tools:visibility="visible">

            <TextView
                android:id="@+id/lblSeasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/seasons"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:id="@+id/scrollSeasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowSeasons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/lblEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:focusable="false"
                android:text="@string/episodes"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtEpisodesStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:focusable="false"
                android:text="@string/loading_episodes"
                android:textColor="@color/emby_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/scrollEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowEpisodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blockExtras"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blockSeasons">

            <TextView
                android:id="@+id/lblExtras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/extras"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowExtras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blockCollection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blockExtras">

            <TextView
                android:id="@+id/lblCollection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/collection"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowCollection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blockCast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blockCollection"
            tools:visibility="visible">

            <TextView
                android:id="@+id/lblCast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/cast"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCastStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:focusable="false"
                android:text="@string/loading_cast"
                android:textColor="@color/emby_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/scrollCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowCast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.piner.pinertv.ui.widget.FocusStableNestedScrollView>

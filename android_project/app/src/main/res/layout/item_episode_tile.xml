<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="128dp"
    android:background="@drawable/bg_episode_tile"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtEpCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/emby_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="E01" />

    <TextView
        android:id="@+id/txtEpTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/emby_text"
        android:textSize="14sp"
        tools:text="Título del episodio" />

    <ProgressBar
        android:id="@+id/progressEp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_continue"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emby_bg_deep"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/library_report"
        android:textColor="@color/emby_accent"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/library_report_subtitle"
        android:textColor="@color/emby_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtReportStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/library_report_scanning"
        android:textColor="@color/emby_text_muted"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/movies"
                android:textColor="@color/emby_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtReportMovies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emby_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="120" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/series"
                android:textColor="@color/emby_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtReportSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emby_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="40" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/episodes"
                android:textColor="@color/emby_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtReportEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emby_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="850" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/library_report_size"
                android:textColor="@color/emby_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtReportSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emby_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="1,2 TB" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

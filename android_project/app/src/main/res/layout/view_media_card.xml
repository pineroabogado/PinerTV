<?xml version="1.0" encoding="utf-8"?>
<!--
  Marco 2:3 (116×174). CardView recorta el póster al mismo radio
  que el stroke verde (6dp) → sin picos cuadrados.
  CardView (no MaterialCardView): Theme.Leanback no es MaterialComponents.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="2dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/framePoster"
        android:layout_width="116dp"
        android:layout_height="174dp"
        android:layout_gravity="center_horizontal"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_card_focus"
        app:cardBackgroundColor="@color/emby_surface"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rating_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="@color/emby_rating"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_poster"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/emby_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtWatched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rating_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="✓"
                android:textColor="@color/emby_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressWatch"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_gravity="bottom"
                android:elevation="3dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_continue"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/emby_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/emby_text_muted"
        android:textSize="10sp" />
</LinearLayout>

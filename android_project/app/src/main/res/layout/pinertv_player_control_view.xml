<?xml version="1.0" encoding="utf-8"?>
<!-- OSD estilo Emby: título, skip/play-pause DPAD, barra de progreso, fade con Media3. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_osd_scrim" />

    <TextView
        android:id="@+id/txtOsdTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textColor="@color/emby_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/selector_osd_btn"
            android:contentDescription="@string/exo_controls_rewind_description"
            android:focusable="true"
            android:nextFocusRight="@id/exo_play_pause"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/exo_icon_rewind" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/selector_osd_btn"
            android:contentDescription="@string/exo_controls_play_description"
            android:focusable="true"
            android:nextFocusLeft="@id/exo_rew"
            android:nextFocusRight="@id/exo_ffwd"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/exo_icon_play" />

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/selector_osd_btn"
            android:contentDescription="@string/exo_controls_fastforward_description"
            android:focusable="true"
            android:nextFocusLeft="@id/exo_play_pause"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/exo_icon_fastforward" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/osdBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_bottom"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="48dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/emby_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="/"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emby_text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSkipIntro"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_osd_chip"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/exo_play_pause"
                android:nextFocusRight="@id/btnOsdChapters"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/skip_intro"
                android:textColor="@color/emby_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnOsdChapters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_osd_chip"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/exo_play_pause"
                android:nextFocusLeft="@id/btnSkipIntro"
                android:nextFocusRight="@id/btnOsdAudio"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/chapters"
                android:textColor="@color/emby_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnOsdAudio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_osd_chip"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/exo_play_pause"
                android:nextFocusLeft="@id/btnOsdChapters"
                android:nextFocusRight="@id/btnOsdSubs"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/audio_tracks"
                android:textColor="@color/emby_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOsdSubs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_osd_chip"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/exo_play_pause"
                android:nextFocusLeft="@id/btnOsdAudio"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/subtitle_tracks"
                android:textColor="@color/emby_text"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            app:bar_height="4dp"
            app:buffered_color="#55FFFFFF"
            app:played_color="@color/emby_accent"
            app:scrubber_color="@color/emby_accent"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="12dp"
            app:unplayed_color="#40FFFFFF" />
    </LinearLayout>

    <!-- IDs opcionales que Media3 espera; ocultos en TV. -->
    <LinearLayout
        android:id="@id/exo_minimal_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:visibility="gone" />

    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />
</merge>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4052B54B" />
            <stroke
                android:width="3dp"
                android:color="@color/emby_accent" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#6652B54B" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
</selector>

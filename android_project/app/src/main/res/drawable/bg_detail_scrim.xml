<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F0101014"
                android:centerColor="#80101014"
                android:endColor="#20101014"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E0101014"
                android:centerColor="#60101014"
                android:endColor="#00101014"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
